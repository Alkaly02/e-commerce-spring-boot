<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
>
    <changeSet id="create_products_table" author="Moussa Alkaly BADJI">
        <createTable tableName="products">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false" unique="true" primaryKeyName="pk_products_id" />
            </column>
            <column name="name" type="VARCHAR(50)">
                <constraints nullable="false "/>
            </column>
            <column name="category_id" type="BIGINT" />

            <column name="created_at" type="DATETIME">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="DATETIME" />
            <column name="created_by" type="BIGINT" />
            <column name="updated_by" type="BIGINT" />
        </createTable>

        <addForeignKeyConstraint baseTableName="products"
                                 baseColumnNames="category_id"
                                 constraintName="product_category_fk"
                                 referencedTableName="categories"
                                 referencedColumnNames="id"
        />

        <createSequence dataType="BIGINT" sequenceName="product_seq" startValue="1000" incrementBy="20" />
    </changeSet>
</databaseChangeLog>